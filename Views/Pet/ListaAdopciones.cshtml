@model List<Evaluacion2.Models.Adoption>

@{
    ViewData["Title"] = "Lista de Adopciones";
}

<div class="container mt-5">
    <div >
        <h3 class="mb-4 text-center text-dark">Lista de Adopciones</h3>

        <table class="table">
            <thead>
                <tr>
                    <th>Mascota</th>
                    <th>Adoptante</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var adopcion in Model)
                {
                    <tr>
                        <td>@adopcion.Pets.Nombre</td>
                        <td>@adopcion.Adopter.Nombre</td>
                        <td>
                           
                             @adopcion.Pets.Estado
                           
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>