@model Evaluacion2.Models.Pet
@{
    ViewData["Title"] = "Registrar Mascota";
}

<h1 style="text-align: center;">Registrar Mascota</h1>
<br>
<p style="text-align: center;">Por favor, complete el siguiente formulario para registrar una nueva mascota. Los campos marcados con * son obligatorios.</p>

<div class="container mt-5">
    <div class="card shadow p-4 rounded">
        <form asp-action="Crear" method="post">
            <div class="mb-3">
                <label asp-for="Nombre" >Nombre</label>
                <input asp-for="Nombre" required />
                <span asp-validation-for="Nombre" ></span>
            </div>

            <div class="mb-3">
                <label asp-for="Edad" >Edad</label>
                <input asp-for="Edad" type="number" min="0"  required />
                <span asp-validation-for="Edad" ></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tipo">Tipo (perro, gato, etc.) </label>
                <input asp-for="Tipo" required />
                <span asp-validation-for="Tipo"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Estado" >Estado de Adopción </label>
                <select asp-for="Estado">
                    <option value="disponible">Disponible</option>
                    <option value="adoptada">Adoptado(a)</option>
                </select>
                <span asp-validation-for="Estado"></span>
            </div>

            <div class="text-center">
                <button type="submit">Registrar Mascota</button>
            </div>
        </form>
    </div>
</div>